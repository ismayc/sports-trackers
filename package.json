{
  "name": "sports-trackers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A family home page for Chester Ismay's sports viewers — which of them have games today, with deep links into each.",
  "author": "Chester Ismay",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
